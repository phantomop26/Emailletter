# VenueHooper Email Campaign Configuration
# Copy this to config/.env and fill in your actual values

# Resend API (for sending emails)
RESEND_API_KEY=your_resend_api_key_here

# OpenAI API (for parsing replies)  
OPENAI_API_KEY=your_openai_api_key_here

# Gmail API Configuration
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_CREDENTIALS_PATH=config/credentials.json
GMAIL_TOKEN_PATH=config/token.json

# Email Configuration
EMAIL_SENDER=onboarding@resend.dev
TEST_EMAIL=your_test_email@gmail.com
BACKUP_TEST_EMAIL=your_backup_email@gmail.com
ORG_NAME=VenueHooper
YOUR_NAME=Your Name
YOUR_PHONE=555-555-5555

# Test Mode Configuration
FORCE_TEST_EMAIL=true
