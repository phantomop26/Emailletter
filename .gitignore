# Environment and secrets
.env
config/.env
config/credentials.json
config/token.json
*.key
*.pem

# API Keys and sensitive data
**/api_keys.txt
**/secrets.json

# Data files (optional - you may want to include sample data)
data/*.csv
data/*.json
!data/sample_venues.csv  # Keep sample data

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Streamlit
.streamlit/secrets.toml

# Playwright browsers (large files)
playwright-browsers/

# Cache
.cache/
.pytest_cache/

# Backup files
*.bak
*.backup